# Copy to .env and adjust

# Backend API origin — leave empty in development (Vite proxy handles /api → localhost:8000)
# In production, set to your backend origin:
# VITE_API_URL=https://api.utilkit.us

# Your production domain (no trailing slash) — used for canonical URLs, og:url, sitemap
VITE_SITE_URL=https://utilkit.us

# ── Dodo Payments ────────────────────────────────────────────
# The single test/live switch for ALL checkout (advert overlay + Support
# button). 'test' uses test.checkout.dodopayments.com; 'live' uses the live
# host. Must match the backend's DODO_URL/DODO_API_KEY mode.
VITE_DODO_MODE=test
# The Dodo "Pay What You Want" product id for the Support button (pdt_...).
# Use the SAME product as the backend's DODO_PAY_WHAT_YOU_WANT.
VITE_DODO_SUPPORT_PRODUCT=
