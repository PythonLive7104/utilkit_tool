# Copy to .env and adjust

# Backend API origin — leave empty in development (Vite proxy handles /api → localhost:8000)
# In production, set to your backend origin:
# VITE_API_URL=https://api.utilkit.us

# Your production domain (no trailing slash) — used for canonical URLs, og:url, sitemap
VITE_SITE_URL=https://utilkit.us

# ── Dodo Payments ────────────────────────────────────────────
# Overlay checkout mode for advert placement: 'test' or 'live'
VITE_DODO_MODE=test
# Hosted checkout host for the "Support our team" Pay-What-You-Want link
VITE_DODO_CHECKOUT_BASE=https://checkout.dodopayments.com
# The Dodo "Pay What You Want" product id used for donations (pdt_...)
VITE_DODO_SUPPORT_PRODUCT=
