# ── Copy this file to .env and fill in your values ───────────
# Development: keep DEBUG=True, leave DATABASE_URL blank (uses SQLite)
# Production:  set DEBUG=False and fill in all sections below

# ── Django core ───────────────────────────────────────────────
# Generate a secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-random-50-char-string

DEBUG=True

# Production: set to your domain (comma-separated, no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────
# Leave blank for SQLite (dev).
# Production: internal Postgres container (docker-compose "db" service). These
# POSTGRES_* values seed that container; DATABASE_URL must use the same creds,
# with host "db" (the compose service name).
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
POSTGRES_DB=utilkit
POSTGRES_USER=utilkit
POSTGRES_PASSWORD=6yhyy67637748825655455555345
DATABASE_URL=postgresql://utilkit:6yhyy67637748825655455555345@db:5432/utilkit
# Set to True only for a managed host that requires SSL (e.g. Supabase).
DB_SSL_REQUIRE=False

# ── CORS (only needed when frontend is on a different origin) ─
# Not needed in production when nginx serves both frontend and backend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── API keys ──────────────────────────────────────────────────
OPENAI_API_KEY=
REMOVE_BG_API_KEY=

# ── Dodo Payments (advert placement + Support our team) ───────
# API key from the Dodo dashboard. Must match the host below (test vs live).
DODO_API_KEY=
# API host: https://test.dodopayments.com (dev) or https://live.dodopayments.com (prod)
DODO_URL=https://live.dodopayments.com
# Product that backs every advert booking (its price = the weekly ad price).
DODO_ADVERT_ID=
# Webhook signing secret shown when you add the webhook endpoint (whsec_...).
DODO_WEBHOOK_SECRET=
# Public site origin Dodo redirects advertisers back to after checkout.
SITE_URL=https://utilkit.us
