# Copy to .env and adjust (on Vercel, set these under Project → Settings → Environment Variables)

# Your production domain (no trailing slash) — used for canonical URLs, og:url, sitemap
VITE_SITE_URL=https://utilkit.us

# ── Dodo Payments (Support button) ───────────────────────────
# 'test' uses test.checkout.dodopayments.com; 'live' uses the live host.
VITE_DODO_MODE=test
# The Dodo "Pay What You Want" product id for the Support button (pdt_...).
VITE_DODO_SUPPORT_PRODUCT=
