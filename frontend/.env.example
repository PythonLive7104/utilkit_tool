# Copy to .env and adjust

# Backend API origin — leave empty in development (Vite proxy handles /api → localhost:8000)
# In production, set to your backend origin:
# VITE_API_URL=https://api.utilkit.us

# Your production domain (no trailing slash) — used for canonical URLs, og:url, sitemap
VITE_SITE_URL=https://utilkit.us
